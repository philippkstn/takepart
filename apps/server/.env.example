# Lokale Entwicklung – kopieren nach apps/server/.env
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5180
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=slides
DB_PASSWORD=slides
DB_NAME=slides
# Einmal-Token zum Registrieren des ersten Passkeys (danach nur noch im eingeloggten Zustand)
SETUP_TOKEN=lokal-einrichten
# Anzahl Proxys vor der App: Uberspace allein 1, mit Cloudflare davor 2
TRUST_PROXY_HOPS=1
